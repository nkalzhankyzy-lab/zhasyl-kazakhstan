# Supabase жобасының мекенжайы мен publishable кілті (Project Settings → API Keys).
# Бұл екеуі берілмесе, платформа деректерді браузердің localStorage-інде сақтайды.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ЖИ экокеңесші үшін Google Gemini кілті (aistudio.google.com). Тек серверде қолданылады.
# Оны .env файлына емес, Vercel → Settings → Environment Variables бөліміне қойыңыз.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
